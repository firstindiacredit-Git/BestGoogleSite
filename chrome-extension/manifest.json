{
  "manifest_version": 3,
  "name": "AllMyTab - Custom New Tab",
  "version": "1.0.0",
  "description": "Replace your new tab page with AllMyTab - a customizable dashboard with tools and bookmarks",
  "permissions": [
    "storage",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://allmytab.com/*",
    "https://*.allmytab.com/*"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AllMyTab Settings"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["newtab.html", "assets/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
